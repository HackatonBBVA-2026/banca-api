# banca-api Environment Configuration Example
# Copy this file to .env to override default parameters

# SQLite connection string using async aiosqlite driver
DATABASE_URL=sqlite+aiosqlite:///./banca.db

# Deterministic random seed for initial data generation
SEED_VALUE=42

# Enable background transaction simulation loop
SIMULATION_ENABLED=True

# Simulation loop minimum interval between ticks (seconds)
SIMULATION_INTERVAL_MIN=10

# Simulation loop maximum interval between ticks (seconds)
SIMULATION_INTERVAL_MAX=30
